  {
   "id": "qvWbkGm30fBQBm11kpoQ",
   "type": "text",
   "x": 2371.52,
   "y": 888.0,
   "width": 876.96,
   "height": 50.625,
   "angle": 0,
   "strokeColor": "#1e1e1e",
