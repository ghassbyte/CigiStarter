  {
   "id": "r1wFigYjJowDyMOLd7SQ",
   "type": "text",
   "x": 2365.715,
   "y": 1088.0,
   "width": 888.57,
   "height": 50.625,
   "angle": 0,
   "strokeColor": "#1e1e1e",
