  {
   "id": "vBqyt638TqanndeoldTx",
   "type": "text",
   "x": 2360.0,
   "y": 2560.0,
   "width": 528.24,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "index": null,
   "seed": 2008205875,
   "version": 1,
   "versionNonce": 1867096361,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "created": null,
   "link": null,
   "locked": false,
   "fontSize": 12,
   "fontFamily": 3,
   "text": "BUILD\n  msbuild CigiStarter.sln /p:Configuration=Release /p:Platform=x64\n  -> x64\\Release\\CigiStarter.exe      (x64 only)\n  GUI subsystem (SubSystem=Windows + EntryPointSymbol=mainCRTStartup)\n  with a plain int main(): no console, so --help, --version and startup\n  errors use a message box\n  static CRT (/MT): a fresh IG PC needs no Visual C++ redistributable\n  no /GL: FSUIPCuser64.lib is an LTCG library built with MSVC v140\n  (WholeProgramOptimization=false; expect a benign LNK4098)\n  runs unelevated (asInvoker) - it starts from a logon path, where a\n  UAC prompt would block an unattended IG\n  vendored SDKs: external\\UIPC64_SDK_C_version2,\n  external\\npcap-sdk-1.16, external\\Prepar3D-SDK\\inc\\PDK\n  (/p:FsuipcSdkDir, /p:NpcapSdkDir, /p:P3DSdkDir)",
   "originalText": "BUILD\n  msbuild CigiStarter.sln /p:Configuration=Release /p:Platform=x64\n  -> x64\\Release\\CigiStarter.exe      (x64 only)\n  GUI subsystem (SubSystem=Windows + EntryPointSymbol=mainCRTStartup)\n  with a plain int main(): no console, so --help, --version and startup\n  errors use a message box\n  static CRT (/MT): a fresh IG PC needs no Visual C++ redistributable\n  no /GL: FSUIPCuser64.lib is an LTCG library built with MSVC v140\n  (WholeProgramOptimization=false; expect a benign LNK4098)\n  runs unelevated (asInvoker) - it starts from a logon path, where a\n  UAC prompt would block an unattended IG\n  vendored SDKs: external\\UIPC64_SDK_C_version2,\n  external\\npcap-sdk-1.16, external\\Prepar3D-SDK\\inc\\PDK\n  (/p:FsuipcSdkDir, /p:NpcapSdkDir, /p:P3DSdkDir)",
