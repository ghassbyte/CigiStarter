   "locked": false,
   "fontSize": 13.5,
   "fontFamily": 2,
   "text": "2 - the object's ISimulation::Update\nused until a frame event has been seen, and again if one stops arriving; Update() defers while the frame event is live, so the two never both\nservice the table",
   "originalText": "2 - the object's ISimulation::Update\nused until a frame event has been seen, and again if one stops arriving; Update() defers while the frame event is live, so the two never both service the table",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "nxkI3BUBD2xTn9tOVC78",
   "lineHeight": 1.25,
   "autoResize": false,
   "baseFontSize": 13.5
  },
