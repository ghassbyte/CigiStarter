   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 2,
   "text": "client.txt sits beside the executable and is read once at startup. Blank lines, # comments and a Notepad BOM are tolerated; IPv4 only. Junk, a\nport of 0 or above 65535, duplicates and this PC's own addresses are skipped and counted. Capped at 32 clients; with no usable line nothing is\nrelayed and the capture driver is never opened.",
   "originalText": "client.txt sits beside the executable and is read once at startup. Blank lines, # comments and a Notepad BOM are tolerated; IPv4 only. Junk, a\nport of 0 or above 65535, duplicates and this PC's own addresses are skipped and counted. Capped at 32 clients; with no usable line nothing is\nrelayed and the capture driver is never opened.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseFontSize": 13
  },
