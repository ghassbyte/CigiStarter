   "fontSize": 34,
   "fontFamily": 1,
   "text": "CigiStarter - a CIGI 3.3 Image Generator",
   "originalText": "CigiStarter - a CIGI 3.3 Image Generator",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
