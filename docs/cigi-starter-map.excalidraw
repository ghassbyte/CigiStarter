   "link": null,
   "locked": false,
   "fontSize": 13.5,
   "fontFamily": 2,
   "text": "3 - a thread of the add-on's own - the last resort\nstarted at DLLStart, stopped and waited for at DLLStop; steps in only after both ticks above have been silent for kWatchGraceMs = 1000 ms.\nIt calls QuerySurfaceElevation and nothing else of Prepar3D's.",
   "originalText": "3 - a thread of the add-on's own - the last resort\nstarted at DLLStart, stopped and waited for at DLLStop; steps in only after both ticks above have been silent for kWatchGraceMs = 1000 ms. It calls QuerySurfaceElevation and nothing else of Prepar3D's.",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "589BbJjP56OYrsVxzaEH",
   "lineHeight": 1.25,
   "autoResize": false,
   "baseFontSize": 13.5
  },
