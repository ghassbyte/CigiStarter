   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 2,
   "text": "Something has to call the free-standing surface query, and it has to keep\nrunning while the aircraft is being positioned. Three ticks, tried in order:",
   "originalText": "Something has to call the free-standing surface query, and it has to keep\nrunning while the aircraft is being positioned. Three ticks, tried in order:",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseFontSize": 14
  },
