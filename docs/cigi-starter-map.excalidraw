  {
   "id": "lFNzE0kBGmxbIfghnzhD",
   "type": "text",
   "x": 74.0,
   "y": 2510.0,
   "width": 254.79000000000002,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
