  {
   "id": "lSdWlRjAPNF6I9btoGx4",
   "type": "text",
   "x": 2360.0,
   "y": 820.0,
   "width": 473.90000000000003,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
