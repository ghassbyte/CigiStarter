  },
  {
   "id": "XFWXLCpaNfhs0gCa05RF",
   "type": "text",
   "x": 60.0,
   "y": 86.0,
   "width": 3235.52,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "index": null,
   "seed": 1458976649,
   "version": 1,
   "versionNonce": 674810504,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "created": null,
   "link": null,
   "locked": false,
   "fontSize": 16,
   "fontFamily": 2,
   "text": "A minimal replacement for the Master IG PC: wakes the HOST with SOF, answers its HAT/HOT requests from the terrain Prepar3D will actually fly the aircraft onto (the PdkTerrainProbe add-on), falls back to an offline SRTM database and then to the sim over FSUIPC, and fans the HOST's downstream stream out to the extra IG PCs. CIGI 3.3, UDP, little-endian. Single Win32 binary, runs unelevated, streams from launch with the\nwindow minimised.",
   "originalText": "A minimal replacement for the Master IG PC: wakes the HOST with SOF, answers its HAT/HOT requests from the terrain Prepar3D will actually fly the aircraft onto (the PdkTerrainProbe add-on), falls back to an offline SRTM database and then to the sim over FSUIPC, and fans the HOST's downstream stream out to the extra IG PCs. CIGI 3.3, UDP, little-endian. Single Win32 binary, runs unelevated, streams from launch with the\nwindow minimised.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseFontSize": 16
  },
