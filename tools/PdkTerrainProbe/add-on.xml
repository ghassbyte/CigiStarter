<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drop this next to the DLL on the IG PC, in Prepar3D's default add-on
  discovery folder, one level deep:

      %USERPROFILE%\Documents\Prepar3D v6 Add-ons\PdkTerrainProbe\
      (or ...\Documents\Prepar3D v5 Add-ons\PdkTerrainProbe\ on v5)

  The "add-ons" folder under %PROGRAMDATA%\Lockheed Martin\Prepar3D vN\ is NOT
  scanned by Prepar3D, so an add-on placed there is never loaded.  Paths below
  are relative to this file.
-->
<SimBase.Document Type="AddOnXml" version="3,3" id="add-on">
    <AddOn.Name>CigiStarter Terrain Probe</AddOn.Name>
    <AddOn.Description>Answers CigiStarter's HAT/HOT terrain queries from Prepar3D's own terrain engine.</AddOn.Description>
    <AddOn.Component>
        <Category>DLL</Category>
        <Path>PdkTerrainProbe.dll</Path>
        <DLLType>PDK</DLLType>
    </AddOn.Component>
</SimBase.Document>
