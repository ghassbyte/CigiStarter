# Visual Studio / MSBuild
.vs/
x64/
Debug/
Release/
*.user
*.suo
*.VC.db
*.VC.opendb
*.tlog

# Build output
*.exe
*.obj
*.pdb
*.ilk
*.log
*.idb
*.iobj
*.ipdb
*.recipe

# The build-identity header is generated into the intermediate directory by the
# PreBuildEvent (tools\gen_buildinfo.ps1). That directory lives under x64\,
# already ignored -- this rule is belt-and-braces so a stray copy anywhere (say,
# the script run by hand into the source tree) stays out too.
BuildInfo.h

# The vendored Npcap SDK keeps its import libraries in a Lib\x64 folder; the
# build-output rule above must not swallow it.
!external/npcap-sdk-1.16/Lib/x64/

# The vendored CIGI Host Emulator is a binary distribution: its executables are
# the whole point of having it in the tree, for the bench tests.
!external/HostEmulator_Win32_v3.3.3/*.exe

# The terrain probe is built once per Prepar3D SDK variant and its output and
# intermediate folders are named for the variant (bin\Release-v5, bin\Release-v6),
# so the generic Release/ rule above does not catch them.
tools/PdkTerrainProbe/bin/
tools/PdkTerrainProbe/obj/

# Editor / OS
*.swp
Thumbs.db
Desktop.ini

# Terrain database (large SRTM .hgt tiles; fetched per site, not committed).
# See tools/get_terrain.ps1.
terrain/
