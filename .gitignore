# Visual Studio / MSBuild
.vs/
x64/
Debug/
Release/
*.user
*.suo
*.VC.db
*.VC.opendb
*.tlog

# Build output
*.exe
*.obj
*.pdb
*.ilk
*.log
*.idb
*.iobj
*.ipdb
*.recipe

# The vendored Npcap SDK keeps its import libraries in a Lib\x64 folder; the
# build-output rule above must not swallow it.
!external/npcap-sdk-1.16/Lib/x64/

# The vendored CIGI Host Emulator is a binary distribution: its executables are
# the whole point of having it in the tree, for the bench tests.
!external/HostEmulator_Win32_v3.3.3/*.exe

# Editor / OS
*.swp
Thumbs.db
Desktop.ini

# Terrain database (large SRTM .hgt tiles; fetched per site, not committed).
# See tools/get_terrain.ps1.
terrain/
