#!/bin/sh
# =====================================================================
#  pre-push  --  refuse to publish a stale generated README region
# ---------------------------------------------------------------------
#  The README's current-build line is generated (sync-docs.ps1 in the
#  shared tooling), and release.ps1 refreshes it on every release, so it
#  is correct in the normal flow. This is the backstop: if a tag is ever
#  cut or changed by hand, or a region edited directly, the push stops
#  here rather than publishing a line that contradicts the tags.
#
#  The fix is one command:
#      powershell -File tools\release\sync-docs.ps1
#
#  Bypass with `git push --no-verify` when the mismatch is understood and
#  intended.
# =====================================================================

root=$(cd "$(dirname "$0")/.." && pwd) || exit 0
script="$root/tools/release/sync-docs.ps1"

# Not adopted (no submodule, or not initialised): nothing to check, and a
# pre-push that fails on a repo that never adopted the tool would be a
# regression. The post-merge hook says something when this matters.
if [ ! -f "$script" ]; then exit 0; fi

if command -v cygpath >/dev/null 2>&1; then
    script=$(cygpath -w "$script")
    root=$(cygpath -w "$root")
fi

powershell -NoProfile -ExecutionPolicy Bypass -File "$script" -Check -RepoRoot "$root"
status=$?

if [ "$status" -ne 0 ]; then
    echo "pre-push: generated docs are stale -- run: powershell -File tools\\release\\sync-docs.ps1" >&2
fi

exit "$status"
