#!/bin/sh
# =====================================================================
#  post-merge  --  tag a proven build on main, automatically
# ---------------------------------------------------------------------
#  The workflow this implements (see the tooling's README, "How a
#  release happens"): branch from main, prove the work there, then
#  merge it into main. Landing on main *is* the definition of proven,
#  so that is the moment to cut the version tag -- and doing it in a
#  hook means the number is never chosen by hand.
#
#  This file is the *consumer side*: a thin dispatcher committed in each
#  project, so a project can be adopted without copying any logic. The
#  rule itself lives once, in tools/release (the shared tooling):
#
#      tools/release/release.ps1    the bump rule, the changelog, the tag
#      tools/release/sync-docs.ps1  the README's current-build line
#
#  The bump comes from the branch name, which is the only statement of
#  intent a hook can read: feature/* -> MINOR, fix/* -> PATCH,
#  major/* or breaking/* -> MAJOR, anything else -> PATCH.
#
#  Silently does nothing when the merge is not new work landing on main:
#    * not on main                     -> no tag
#    * a squash merge                  -> no tag (nothing committed yet)
#    * `git pull` (reflog "pull ...")  -> no tag
#    * merging a remote-tracking ref   -> no tag
#    * HEAD already carries a vX.Y.Z   -> no tag (idempotent, so a
#      re-run or a second merge cannot double-tag)
#
#  It never pushes, so a bad tag is caught before it is published:
#      git push origin main vX.Y.Z
#
#  Installing it is one line per clone -- git does not do it for you:
#      git config core.hooksPath .githooks
#
#  Refreshing the tooling itself is one line per project, then a commit
#  of the moved pointer:
#      git update-tooling
# =====================================================================

# A squash merge commits nothing of its own yet; there is no merge commit to
# stand on. (git passes "1" as the sole argument for --squash.)
if [ "$1" = "1" ]; then
    exit 0
fi

# Only ever act on main.
if [ "$(git symbolic-ref --short -q HEAD 2>/dev/null)" != "main" ]; then
    exit 0
fi

# What did git just merge? The reflog entry names it:
#     merge feature/roll-sign: Fast-forward
#     merge fix/reposition: Merge made by the 'ort' strategy.
# A `git pull` writes "pull ...", which this deliberately does not match, so
# fetching someone else's work never cuts a version.
subject=$(git reflog -1 --format=%gs 2>/dev/null) || exit 0
case "$subject" in
    merge\ *) ;;
    *) exit 0 ;;
esac
merged=${subject#merge }
merged=${merged%%:*}

# Only a local branch being folded in is new work worth tagging.
if [ -z "$merged" ]; then exit 0; fi
case "$merged" in
    HEAD|origin/*) exit 0 ;;
esac

# Resolve the repository root from this script's own location, so the hook works
# however git was launched.
root=$(cd "$(dirname "$0")/.." && pwd) || exit 0
script="$root/tools/release/release.ps1"

# The tooling is a submodule: a fresh clone that has not run
# `git submodule update --init` has an empty tools/release. Say so rather than
# failing silently -- the commonest reason a tag does not appear is exactly this.
if [ ! -f "$script" ]; then
    echo "[tag] release tooling is not checked out (tools/release is empty)."
    echo "[tag] run: git submodule update --init"
    exit 0
fi

if command -v cygpath >/dev/null 2>&1; then
    script=$(cygpath -w "$script")
    root=$(cygpath -w "$root")
fi

powershell -NoProfile -ExecutionPolicy Bypass -File "$script" -Branch "$merged" -RepoRoot "$root"

# A hook must never change the outcome of the merge it follows.
exit 0
