<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{28bb4e88-e043-497a-9c36-8ea6cb94ab40}</ProjectGuid>
    <RootNamespace>CigiStarter</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <!-- MUST stay false: FSUIPCuser64.lib is a prebuilt MSVC v140 LTCG
         library. Building this project with /GL and then linking it fails with
         C1047 / LNK1257 ("created by a different version of the compiler").
         Without /GL the linker handles the mixed LTCG inputs fine. -->
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <!-- Both SDKs are vendored in external\ so this folder builds on its own.
         Override on the command line to build against another copy, e.g.
           msbuild ... /p:FsuipcSdkDir=C:\path\to\UIPC64_SDK_C_version2 -->
    <!-- FSUIPC: the prebuilt v140 library, so this program and CigiP3dBridge
         always agree on the wire format whatever built them. -->
    <FsuipcSdkDir Condition="'$(FsuipcSdkDir)'==''">$(ProjectDir)external\UIPC64_SDK_C_version2</FsuipcSdkDir>
    <!-- Npcap headers, for the client.txt fan-out (Relay.cpp). Only the
         headers are needed: wpcap.dll is loaded with LoadLibrary() at run
         time, so this program still starts on an IG PC that has no Npcap. -->
    <NpcapSdkDir Condition="'$(NpcapSdkDir)'==''">$(ProjectDir)external\npcap-sdk-1.16</NpcapSdkDir>
  </PropertyGroup>
  <!-- Static CRT (/MT, /MTd) so the exe runs on a fresh IG PC with no
       Visual C++ redistributable installation. -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- $(IntDir) carries the generated BuildInfo.h on the include path so
           src\Version.cpp can #include it (see the PreBuildEvent below). -->
      <AdditionalIncludeDirectories>$(IntDir);$(FsuipcSdkDir);$(NpcapSdkDir)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Windowed program: the operator window is the only interface. The
           subsystem must be Windows so no console is created, and the entry
           point stays mainCRTStartup so plain int main(argc, argv) still works
           (SUBSYSTEM:Windows would otherwise demand WinMain). -->
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>ws2_32.lib;iphlpapi.lib;winmm.lib;user32.lib;$(FsuipcSdkDir)\FSUIPCuser64.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Unelevated (asInvoker): a deployment starts this from a logon or
           startup path, where a UAC prompt would block an unattended IG.
           Nothing here needs administrator on a normal install; the fan-out
           opens Npcap unelevated (see README.md). -->
      <UACExecutionLevel>AsInvoker</UACExecutionLevel>
      <UACUIAccess>false</UACUIAccess>
    </Link>
    <!-- Build identity: derive the version string from git and compile it in,
         so the exe can name its own build (its version message box and the
         operator window's title). The generated header lands in the
         intermediate directory (git-ignored, an artefact, never edited by hand)
         and is on the include path via the ClCompile AdditionalIncludeDirectories
         above. See src\Version.h and tools\gen_buildinfo.ps1. The script leaves
         the file untouched when the string would not change, so an unchanged
         tree does not force a recompile. -->
    <PreBuildEvent>
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)tools\gen_buildinfo.ps1" -OutFile "$(IntDir)BuildInfo.h" -RepoDir "$(MSBuildThisFileDirectory)." -Configuration "$(Configuration)"</Command>
      <Message>Generating BuildInfo.h from git describe</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- $(IntDir) carries the generated BuildInfo.h on the include path so
           src\Version.cpp can #include it (see the PreBuildEvent below). -->
      <AdditionalIncludeDirectories>$(IntDir);$(FsuipcSdkDir);$(NpcapSdkDir)\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- See the Debug configuration: windowed subsystem, main() entry. -->
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>mainCRTStartup</EntryPointSymbol>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>ws2_32.lib;iphlpapi.lib;winmm.lib;user32.lib;$(FsuipcSdkDir)\FSUIPCuser64.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- See the Debug configuration: asInvoker, not requireAdministrator. -->
      <UACExecutionLevel>AsInvoker</UACExecutionLevel>
      <UACUIAccess>false</UACUIAccess>
    </Link>
    <!-- See the Debug|x64 note above: this derives the build identity from git
         into the git-ignored intermediate directory before the compiler runs. -->
    <PreBuildEvent>
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildThisFileDirectory)tools\gen_buildinfo.ps1" -OutFile "$(IntDir)BuildInfo.h" -RepoDir "$(MSBuildThisFileDirectory)." -Configuration "$(Configuration)"</Command>
      <Message>Generating BuildInfo.h from git describe</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\Gui.cpp" />
    <ClCompile Include="src\cigi.cpp" />
    <ClCompile Include="src\Relay.cpp" />
    <ClCompile Include="src\TerrainDb.cpp" />
    <ClCompile Include="src\TerrainProbe.cpp" />
    <ClCompile Include="src\TerrainSource.cpp" />
    <ClCompile Include="src\Version.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\cigi.h" />
    <ClInclude Include="src\Gui.h" />
    <ClInclude Include="src\Relay.h" />
    <ClInclude Include="src\SofPacer.h" />
    <ClInclude Include="src\TerrainDb.h" />
    <ClInclude Include="src\TerrainProbe.h" />
    <ClInclude Include="src\TerrainProbeIpc.h" />
    <ClInclude Include="src\TerrainSource.h" />
    <ClInclude Include="src\Version.h" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
    <None Include="agents.md" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>